#!/usr/bin/env bash
# {{ ansible_managed }}

set -euo pipefail

LOG_DIR="{{ logcleanup_log_dir }}"
RETENTION_DAYS="{{ logcleanup_retention_days }}"
LOG_SUFFIX="{{ logcleanup_file_suffix }}"

{% if logcleanup_dry_run | default(false) | bool %}
find "$LOG_DIR" -type f -name "$LOG_SUFFIX" \
    -mtime +"$RETENTION_DAYS" -print
logger -t logcleanup "dry run: listed matching files older than ${RETENTION_DAYS} days in ${LOG_DIR}"
{% else %}
deleted=$(find "$LOG_DIR" -type f -name "$LOG_SUFFIX" \
    -mtime +"$RETENTION_DAYS" -print -delete | wc -l)
logger -t logcleanup "removed ${deleted} file(s) older than ${RETENTION_DAYS} days from ${LOG_DIR}"
{% endif %}
